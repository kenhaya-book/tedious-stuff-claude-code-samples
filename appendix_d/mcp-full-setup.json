{
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": ["-y", "@anthropic/claude-code-gmail-mcp"]
    },
    "google-calendar": {
      "command": "npx",
      "args": ["-y", "@anthropic/claude-code-google-calendar-mcp"]
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@anthropic/claude-code-slack-mcp"]
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@anthropic/claude-code-notion-mcp"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_xxxx"
      }
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    }
  }
}
